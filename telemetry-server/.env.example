# Copy this to Portainer → Stacks → Environment variables.
# Never commit real values to the repo.

# Docker image tag for the Go API (set to "latest" to always pull latest build,
# or pin to a specific tag like "v0.1.2" for controlled rollouts)
API_VERSION=latest

# PostgreSQL password — generate with: openssl rand -base64 32
POSTGRES_PASSWORD=changeme

# Admin bearer token for /api/admin/* endpoints — generate with: openssl rand -hex 32
ADMIN_TOKEN=changeme

# Grafana admin UI password
GRAFANA_PASSWORD=changeme

# Caddy basic_auth hash for the /grafana route — generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'yourpassword'
GRAFANA_BASIC_HASH=$2a$14$...
