{
  "title": "Fleet Overview",
  "uid": "fleet-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active Devices (seen last 24h)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{
        "datasource": { "type": "postgres" },
        "rawSql": "SELECT COUNT(*) AS value FROM devices WHERE last_seen > NOW() - INTERVAL '24 hours'",
        "format": "table"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sessions (last 7d)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{
        "datasource": { "type": "postgres" },
        "rawSql": "SELECT COUNT(*) AS value FROM sessions WHERE started_at > NOW() - INTERVAL '7 days'",
        "format": "table"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Events (last 7d)",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{
        "datasource": { "type": "postgres" },
        "rawSql": "SELECT COUNT(*) AS value FROM events WHERE server_ts > NOW() - INTERVAL '7 days'",
        "format": "table"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error Events (last 7d)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{
        "datasource": { "type": "postgres" },
        "rawSql": "SELECT COUNT(*) AS value FROM events WHERE event_type = 'error' AND server_ts > NOW() - INTERVAL '7 days'",
        "format": "table"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "thresholds": { "steps": [{"color":"green","value":0},{"color":"yellow","value":5},{"color":"red","value":20}] } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Sessions per Day",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{
        "datasource": { "type": "postgres" },
        "rawSql": "SELECT date_trunc('day', started_at) AS time, COUNT(*) AS sessions FROM sessions WHERE started_at > NOW() - INTERVAL '30 days' GROUP BY 1 ORDER BY 1",
        "format": "time_series"
      }]
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Firmware Version Distribution",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{
        "datasource": { "type": "postgres" },
        "rawSql": "SELECT current_firmware AS metric, COUNT(*) AS value FROM devices WHERE current_firmware IS NOT NULL GROUP BY current_firmware ORDER BY value DESC",
        "format": "table"
      }]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top Error Types (last 7d)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{
        "datasource": { "type": "postgres" },
        "rawSql": "SELECT event_type, COUNT(*) AS count FROM events WHERE server_ts > NOW() - INTERVAL '7 days' GROUP BY event_type ORDER BY count DESC LIMIT 20",
        "format": "table"
      }],
      "options": { "sortBy": [{"displayName":"count","desc":true}] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Audio Underruns per Hour",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{
        "datasource": { "type": "postgres" },
        "rawSql": "SELECT date_trunc('hour', server_ts) AS time, COUNT(*) AS underruns FROM events WHERE event_type = 'audio_underrun' AND server_ts > NOW() - INTERVAL '7 days' GROUP BY 1 ORDER BY 1",
        "format": "time_series"
      }]
    }
  ]
}
